{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna terdaftar untuk auto-fill formulir, identitas akun, gamifikasi, streak login, dan status Menwa UNJ",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID unik pengguna dari Firebase Auth", "maxLength": 128 },
        "email": { "type": "string", "description": "Alamat email pengguna", "maxLength": 150 },
        "displayName": { "type": "string", "description": "Nama lengkap pengguna", "maxLength": 120 },
        "institution": { "type": "string", "description": "Asal instansi/kampus/organisasi", "maxLength": 150 },
        "occupation": {
          "type": "string",
          "description": "Pekerjaan/status pengguna (Mahasiswa, TNI/Polri, Pemerintahan, Karyawan Swasta, Umum)",
          "enum": ["Mahasiswa", "TNI/Polri", "Pemerintahan", "Karyawan Swasta", "Umum"],
          "maxLength": 50
        },
        "birthDate": { "type": "string", "description": "Tanggal lahir pemohon format YYYY-MM-DD", "maxLength": 20 },
        "phone": { "type": "string", "description": "Nomor kontak WhatsApp / HP", "maxLength": 30 },
        "isMenwaMember": { "type": "boolean", "description": "Penanda bahwa pengguna mengklaim sebagai anggota Menwa UNJ" },
        "menwaNia": { "type": "string", "description": "Nomor Induk Anggota / Bataliyon Menwa UNJ", "maxLength": 50 },
        "isVerifiedMenwa": { "type": "boolean", "description": "Status verifikasi resmi centang biru oleh Admin Mako" },
        "tacticalPoints": { "type": "number", "description": "Total poin taktis akumulasi dari gamifikasi & kuis harian" },
        "weeklyPoints": { "type": "number", "description": "Total poin taktis pekan berjalan" },
        "monthlyPoints": { "type": "number", "description": "Total poin taktis bulan berjalan" },
        "currentStreak": { "type": "number", "description": "Jumlah hari berturut-turut login aktif" },
        "longestStreak": { "type": "number", "description": "Rekor streak terpanjang pengguna" },
        "lastStreakDate": { "type": "string", "description": "Tanggal terakhir login tercatat (YYYY-MM-DD)", "maxLength": 20 },
        "streakMilestonesClaimed": { "type": "array", "description": "Daftar milestone 7-hari yang sudah diklaim bonus EXP-nya" },
        "streakFreezesCount": { "type": "number", "description": "Jumlah item perlindungan Streak Freeze yang dimiliki pengguna" },
        "lastQuizDate": { "type": "string", "description": "Tanggal penyelesaian kuis harian terakhir YYYY-MM-DD", "maxLength": 20 },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan profil ISO string", "maxLength": 50 }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Sertifikat digital kompetensi & kejuaraan nasional Menwa UNJ",
      "type": "object",
      "properties": {
        "certId": { "type": "string", "description": "Nomor seri sertifikat unik", "maxLength": 128 },
        "courseId": { "type": "string", "description": "ID kursus atau program yang diselesaikan", "maxLength": 60 },
        "courseTitle": { "type": "string", "description": "Judul program pelatihan atau kompetisi", "maxLength": 150 },
        "recipientName": { "type": "string", "description": "Nama penerima sertifikat", "maxLength": 160 },
        "institution": { "type": "string", "description": "Asal instansi atau satuan penerima", "maxLength": 160 },
        "recipientEmail": { "type": "string", "description": "Email penerima", "maxLength": 150 },
        "programCode": { "type": "string", "enum": ["KC_VIII", "GERANAT_VII", "YOUTH_SPARK", "DIKSAR"], "maxLength": 40 },
        "eventName": { "type": "string", "maxLength": 200 },
        "categoryOrRank": { "type": "string", "maxLength": 160 },
        "predicate": { "type": "string", "maxLength": 160 },
        "eventDate": { "type": "string", "maxLength": 80 },
        "issuedDate": { "type": "string", "maxLength": 80 },
        "issuedAt": { "type": "string", "description": "Tanggal penerbitan ISO string", "maxLength": 50 },
        "signedBy": { "type": "string", "maxLength": 120 },
        "signerTitle": { "type": "string", "maxLength": 140 },
        "decreeNumber": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["SAH_TERVERIFIKASI", "DICABUT"], "maxLength": 40 },
        "grade": { "type": "string", "description": "Predikat kelulusan (Sangat Baik / Unggul)", "maxLength": 40 }
      },
      "required": ["certId", "recipientName"]
    },
    "SiteCmsConfig": {
      "title": "SiteCmsConfig",
      "description": "Konfigurasi CMS Terpadu Beranda, Hero Slider, Sorotan Giat, Program Unggulan, dan Dinding Galeri Lensa",
      "type": "object",
      "properties": {
        "version": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 120 },
        "heroScenes": { "type": "array", "description": "Daftar slide hero utama beranda" },
        "sorotanGiat": { "type": "array", "description": "Daftar kartu Sorotan Giat beranda" },
        "programs": { "type": "array", "description": "Daftar Program Unggulan untuk Matriks Navigasi Peran" },
        "galleryAlbums": { "type": "array", "description": "Daftar album Dinding Galeri Lensa terpadu" }
      },
      "required": ["version", "updatedAt", "updatedBy", "heroScenes", "sorotanGiat", "programs", "galleryAlbums"]
    },
    "AdminuTicket": {
      "title": "AdminuTicket",
      "description": "Tiket Smart Adminu & Permohonan Layanan / Pengamanan Kegiatan (PAM-2026-XXX)",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "pattern": "^PAM-2026-[0-9]{3,6}$", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "applicantName": { "type": "string", "maxLength": 120 },
        "institution": { "type": "string", "maxLength": 150 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "contactEmail": { "type": "string", "maxLength": 120 },
        "serviceCategory": {
          "type": "string",
          "enum": [
            "PAM_KEGIATAN",
            "KEMITRAAN_INSTANSI",
            "INSTRUKTUR_PELATIH",
            "SARPRAS_KOMANDO",
            "PENDAFTARAN_PROGRAM",
            "DISPENSASI_IZIN"
          ],
          "maxLength": 40
        },
        "serviceLabel": { "type": "string", "maxLength": 120 },
        "eventName": { "type": "string", "maxLength": 180 },
        "eventDate": { "type": "string", "maxLength": 40 },
        "eventLocation": { "type": "string", "maxLength": 180 },
        "personnelRequested": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "letterNumber": { "type": "string", "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["DITERIMA", "DISETUJUI", "VERIFIKASI_ADMINU", "AUDIENSI_POLA_PAM", "PERSONEL_DITUGASKAN"],
          "maxLength": 40
        },
        "statusNote": { "type": "string", "maxLength": 400 },
        "attachmentPdfName": { "type": "string", "maxLength": 160 },
        "attachmentPdfUrl": { "type": "string", "maxLength": 1000 },
        "attachmentPdfSizeKb": { "type": "number" },
        "linkedLetterNumber": { "type": "string", "maxLength": 80 }
      },
      "required": [
        "ticketId",
        "createdAt",
        "applicantName",
        "institution",
        "contactPhone",
        "serviceCategory",
        "serviceLabel",
        "eventName",
        "eventDate",
        "eventLocation",
        "personnelRequested",
        "letterNumber",
        "status",
        "statusNote"
      ]
    },
    "FormSubmission": {
      "title": "FormSubmission",
      "description": "Data permohonan administrasi digital atau pengajuan surat resmi lanjutan dari tiket disetujui",
      "type": "object",
      "properties": {
        "submissionId": { "type": "string", "description": "Nomor surat resmi B-001/Web/<Romawi>/2026 atau ID pengajuan", "maxLength": 128 },
        "ticketId": { "type": "string", "description": "Kode tiket PAM-2026-XXX yang terhubung (jika pengajuan tahap 2)", "maxLength": 40 },
        "serviceType": { "type": "string", "description": "Jenis formulir administrasi", "maxLength": 60 },
        "applicantUid": { "type": "string", "description": "UID pengguna pemohon", "maxLength": 128 },
        "applicantEmail": { "type": "string", "description": "Email pemohon", "maxLength": 150 },
        "email": { "type": "string", "description": "Email aktif pemohon", "maxLength": 150 },
        "fullName": { "type": "string", "description": "Nama lengkap pemohon", "maxLength": 120 },
        "institution": { "type": "string", "description": "Asal instansi", "maxLength": 150 },
        "occupation": { "type": "string", "description": "Pekerjaan pemohon", "maxLength": 50 },
        "birthDate": { "type": "string", "description": "Tanggal lahir pemohon", "maxLength": 20 },
        "phone": { "type": "string", "description": "Nomor kontak", "maxLength": 30 },
        "title": { "type": "string", "description": "Perihal permohonan atau nama kegiatan", "maxLength": 200 },
        "purpose": { "type": "string", "description": "Keterangan detail pengajuan", "maxLength": 2000 },
        "notes": { "type": "string", "description": "Catatan tambahan pemohon", "maxLength": 1000 },
        "documentPdfName": { "type": "string", "description": "Nama berkas PDF maksimal 1 MB", "maxLength": 160 },
        "documentPdfUrl": { "type": "string", "description": "URL unduhan Firebase Storage", "maxLength": 1000 },
        "documentPdfSizeKb": { "type": "number", "description": "Ukuran berkas PDF dalam KB" },
        "documentStorageMode": { "type": "string", "maxLength": 40 },
        "status": {
          "type": "string",
          "description": "Status proses administrasi",
          "enum": ["menunggu_konfirmasi", "diproses", "disetujui", "ditolak", "selesai"],
          "maxLength": 40
        },
        "participantToken": { "type": "string", "description": "Token akses unik ke Portal Peserta", "maxLength": 50 },
        "createdAt": { "type": "string", "description": "Waktu pengajuan ISO string", "maxLength": 50 }
      },
      "required": ["submissionId", "serviceType", "applicantUid", "fullName", "institution", "occupation", "birthDate", "phone", "status"]
    },
    "GeranatTeam": {
      "title": "GeranatTeam",
      "description": "Kontingen tim paskibra peserta GERANAT untuk e-voting juara terfavorit",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "description": "ID unik tim kontingen", "maxLength": 128 },
        "teamName": { "type": "string", "description": "Nama pasukan/tim paskibra", "maxLength": 150 },
        "institution": { "type": "string", "description": "Asal sekolah/instansi kontingen", "maxLength": 150 },
        "category": { "type": "string", "description": "Kategori tingkatan (Wira Utama SMA/SMK atau Madya SMP)", "maxLength": 60 },
        "dantonName": { "type": "string", "description": "Nama Komandan Pleton (Danton)", "maxLength": 120 },
        "motto": { "type": "string", "description": "Motto atau jargon pasukan", "maxLength": 200 },
        "votesCount": { "type": "number", "description": "Jumlah total suara terhimpun dari e-voting berbayar" },
        "photoUrl": { "type": "string", "description": "URL foto tim kontingen", "maxLength": 500 },
        "updatedAt": { "type": "string", "description": "Waktu update terakhir ISO string", "maxLength": 50 }
      },
      "required": ["teamId", "teamName", "institution", "votesCount"]
    },
    "VotingTransaction": {
      "title": "VotingTransaction",
      "description": "Transaksi e-voting berbayar Rp1.000 per suara dengan QRIS dinamis",
      "type": "object",
      "properties": {
        "txId": { "type": "string", "description": "ID unik transaksi voting", "maxLength": 128 },
        "teamId": { "type": "string", "description": "ID tim yang didukung", "maxLength": 128 },
        "teamName": { "type": "string", "description": "Nama tim yang didukung", "maxLength": 150 },
        "voterUid": { "type": "string", "description": "UID pengguna pemberi dukungan", "maxLength": 128 },
        "voterName": { "type": "string", "description": "Nama pendukung", "maxLength": 120 },
        "votes": { "type": "number", "description": "Jumlah dukungan suara yang dibeli" },
        "amount": { "type": "number", "description": "Nominal pembayaran (Rp)" },
        "paymentMethod": { "type": "string", "description": "Metode pembayaran (QRIS Dinamis)", "maxLength": 50 },
        "status": { "type": "string", "description": "Status transaksi pembayaran", "enum": ["menunggu_pembayaran", "lunas", "batal"], "maxLength": 40 },
        "qrisPayload": { "type": "string", "description": "String payload QRIS EMVCo dengan nominal terkunci", "maxLength": 1000 },
        "createdAt": { "type": "string", "description": "Waktu transaksi ISO string", "maxLength": 50 }
      },
      "required": ["txId", "teamId", "votes", "amount", "status"]
    },
    "ParticipantPortal": {
      "title": "ParticipantPortal",
      "description": "Portal peserta terdigitalisasi untuk kartu peserta, pemberkasan dokumen, dan rekap penilaian",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Token unik peserta format REG-XXX-YYYY-ZZZZ", "maxLength": 60 },
        "programSlug": { "type": "string", "description": "Slug program (geranat, kc, youth-spark)", "maxLength": 60 },
        "programTitle": { "type": "string", "description": "Nama lengkap program", "maxLength": 150 },
        "applicantUid": { "type": "string", "description": "UID akun pendaftar utama", "maxLength": 128 },
        "applicantName": { "type": "string", "description": "Nama lengkap penanggung jawab kontingen", "maxLength": 120 },
        "teamName": { "type": "string", "description": "Nama kontingen / tim", "maxLength": 150 },
        "institution": { "type": "string", "description": "Asal sekolah / kampus", "maxLength": 150 },
        "registrationNumber": { "type": "string", "description": "Nomor urut tampil / registrasi", "maxLength": 50 },
        "paymentStatus": { "type": "string", "description": "Status pembayaran pendaftaran", "enum": ["menunggu_verifikasi", "lunas", "tertunda"], "maxLength": 40 },
        "documents": { "type": "array", "description": "Daftar berkas persyaratan yang diunggah" },
        "juryScores": { "type": "array", "description": "Rekapitulasi penilaian dewan juri" },
        "createdAt": { "type": "string", "description": "Waktu registrasi ISO string", "maxLength": 50 },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan ISO string", "maxLength": 50 }
      },
      "required": ["token", "programSlug", "applicantUid", "teamName", "paymentStatus"]
    },
    "BankQRISConfig": {
      "title": "BankQRISConfig",
      "description": "Konfigurasi rekening bank resmi dan payload QRIS merchant Mako",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 80 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "accountHolder": { "type": "string", "maxLength": 100 },
        "merchantName": { "type": "string", "maxLength": 100 },
        "merchantCity": { "type": "string", "maxLength": 60 },
        "qrisPayload": { "type": "string", "maxLength": 1024 },
        "nmid": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["bankName", "accountNumber", "accountHolder"]
    },
    "OfficialPortal": {
      "title": "OfficialPortal",
      "description": "Data Portal Official per sekolah (/official/{schoolSlug}) mencakup nomor WhatsApp terdaftar, profil sekolah, 5 berkas, 20 biodata tim (18 pasukan + 2 official), dan skor penilaian GERANAT",
      "type": "object",
      "properties": {
        "schoolSlug": { "type": "string", "maxLength": 100 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "eventTitle": { "type": "string", "maxLength": 150 },
        "nomorUrut": { "type": "string", "maxLength": 30 },
        "juryName": { "type": "string", "maxLength": 120 },
        "schoolProfile": { "type": "object" },
        "documents": { "type": "object" },
        "pasukanList": { "type": "array" },
        "officialList": { "type": "array" },
        "scores": { "type": "object" },
        "penalties": { "type": "object" },
        "bonuses": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["schoolSlug", "schoolName", "whatsappNumber"]
    },
    "PublicVerification": {
      "title": "PublicVerification",
      "description": "Registri verifikasi publik non-sensitif surat resmi SOP Menwa UNJ & integrasi E-Spri untuk pemindaian QR (/verifikasi?hash=...)",
      "type": "object",
      "properties": {
        "hash": { "type": "string", "description": "Token/hash unik verifikasi yang sama dengan Document ID", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 3, "maxLength": 128 },
        "letterNumber": { "type": "string", "description": "Nomor surat resmi sesuai SOP (contoh: B-045/Sat-UNJ/XI/2026)", "maxLength": 100 },
        "agendaNumber": { "type": "string", "description": "Nomor urut agenda surat E-Spri (opsional, contoh: 045)", "maxLength": 40 },
        "letterType": { "type": "string", "description": "Jenis naskah dinas (Surat Tugas, Undangan, Permohonan, Keterangan, Nota Dinas)", "maxLength": 80 },
        "subject": { "type": "string", "description": "Perihal surat resmi", "maxLength": 240 },
        "recipient": { "type": "string", "description": "Tujuan / penerima surat", "maxLength": 200 },
        "issuingUnit": { "type": "string", "description": "Satuan atau bagian penerbit surat", "maxLength": 180 },
        "issuedDate": { "type": "string", "description": "Tanggal penerbitan surat", "maxLength": 40 },
        "validUntil": { "type": "string", "description": "Batas masa berlaku surat (opsional)", "maxLength": 40 },
        "signerName": { "type": "string", "description": "Nama pejabat penandatangan", "maxLength": 120 },
        "signerTitle": { "type": "string", "description": "Jabatan pejabat penandatangan", "maxLength": 140 },
        "signerNia": { "type": "string", "description": "Nomor Induk Anggota / NBP pejabat penandatangan (opsional)", "maxLength": 50 },
        "status": { "type": "string", "enum": ["SAH", "TERVERIFIKASI", "MENUNGGU_TTD", "DICABUT", "KEDALUWARSA"], "maxLength": 30 },
        "statusReason": { "type": "string", "description": "Alasan atau keterangan status surat", "maxLength": 300 },
        "documentSha256": { "type": "string", "description": "Hash SHA-256 berkas PDF asli (opsional)", "maxLength": 128 },
        "verificationUrl": { "type": "string", "description": "Tautan QR verifikasi resmi", "maxLength": 300 },
        "source": { "type": "string", "enum": ["E-SPRI", "ADMINU", "EDISPENSASI"], "maxLength": 30 },
        "createdAt": { "type": "string", "description": "Waktu pencatatan ISO 8601", "maxLength": 50 },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan terakhir ISO 8601", "maxLength": 50 }
      },
      "required": ["hash", "letterNumber", "letterType", "subject", "recipient", "issuedDate", "signerName", "signerTitle", "status", "source", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Data profil akun, streak login, poin taktis, dan status keanggotaan"
    },
    "/users/{userId}/certificates/{certId}": {
      "schema": "Certificate",
      "description": "Sertifikat kelulusan digital yang diraih oleh pengguna"
    },
    "/certificates/{certId}": {
      "schema": "Certificate",
      "description": "Registri publik verifikasi sertifikat dan piagam resmi (/verify)"
    },
    "/publicVerifications/{hash}": {
      "schema": "PublicVerification",
      "description": "Registri verifikasi publik QR surat resmi E-Spri & Mako (/verifikasi)"
    },
    "/site_cms_config/{configId}": {
      "schema": "SiteCmsConfig",
      "description": "Konfigurasi CMS Beranda & Dinding Galeri Lensa yang dikelola Staf Komando (/mako-ops)"
    },
    "/adminu_tickets/{ticketId}": {
      "schema": "AdminuTicket",
      "description": "Tiket Smart Adminu & Permohonan Pengamanan Kegiatan (PAM-2026-XXX)"
    },
    "/forms_submissions/{submissionId}": {
      "schema": "FormSubmission",
      "description": "Berkas permohonan administrasi dan pendaftaran program terpadu"
    },
    "/geranat_teams/{teamId}": {
      "schema": "GeranatTeam",
      "description": "Daftar tim kontingen paskibra GERANAT untuk e-voting"
    },
    "/voting_transactions/{txId}": {
      "schema": "VotingTransaction",
      "description": "Catatan transaksi e-voting berbayar Rp1.000"
    },
    "/participant_portals/{token}": {
      "schema": "ParticipantPortal",
      "description": "Data portal peserta digital untuk pemberkasan dan rekap nilai"
    },
    "/official_portals/{schoolSlug}": {
      "schema": "OfficialPortal",
      "description": "Data Portal Official sekolah (/official/{schoolSlug}) dengan login WhatsApp"
    },
    "/settings/{settingId}": {
      "schema": "BankQRISConfig",
      "description": "Konfigurasi operasional Mako termasuk rekening bank dan QRIS resmi"
    }
  }
}