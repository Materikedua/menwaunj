rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['unjmenwa@gmail.com', 'rafflysyahpoetra@gmail.com']
      );
    }

    function isValidImageOrPdf() {
      return (
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType == 'application/pdf'
      ) && request.resource.size <= 15 * 1024 * 1024;
    }

    // Aset publik (bisa dibaca publik, hanya bisa ditulis admin terotorisasi)
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Berkas pengajuan formulir administrasi pengguna terverifikasi
    match /submissions/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin()) && isValidImageOrPdf();
    }

    // Berkas pendaftaran & foto kontingen official (LFPB Geranat VII / KC VIII)
    match /official/{schoolSlug}/{allPaths=**} {
      allow read: if true;
      allow write: if isValidImageOrPdf();
    }

    // Default Fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
