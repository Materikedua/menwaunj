rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['unjmenwa@gmail.com', 'rafflysyahpoetra@gmail.com']
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 15 * 1024 * 1024;
    }

    // Aset publik (bisa dibaca publik, hanya bisa ditulis admin terotorisasi)
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Berkas pendaftaran & foto kontingen official
    match /official/{schoolSlug}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() || isValidImage();
    }

    // Default Fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
